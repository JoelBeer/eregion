{
  "name": "eregion",
  "version": "0.1.0",
  "description": "A desktop app that moves Linear tickets through a configurable pipeline of AI agents, each in its own git worktree.",
  "private": true,
  "license": "MIT",
  "author": "Joel Beer",
  "repository": "github:JoelBeer/eregion",
  "engines": { "node": ">=22" },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "electron-vite preview",
    "icons": "node scripts/make-icons.mjs",
    "install-launcher": "bash scripts/install-launcher.sh",
    "preview:web": "electron-vite build && vite build --config vite.web.config.mts && node out/web/server.cjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "better-sqlite3": "^13.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
